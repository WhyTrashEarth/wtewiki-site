---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n/ui";
const locale = Astro.currentLocale;
---
<BaseLayout title={t(locale, "contact_title")} description="Contact WhyTrashEarth.">
<section class="card p-24" aria-labelledby="contact-title">
  <h1 id="contact-title" class="h1">Contact Us</h1>

  <p class="muted" style="max-width: 75ch; line-height: 1.65;">
    We prefer direct communication. If you have a question, idea, or would like to work with us, please reach out via email.
  </p>

  <p style="margin-top: 1.5rem;">
    <a class="button" href="mailto:wte23@pm.me?subject=Email%20from%20WTE%20Wiki">Email WTE Wiki</a>
  </p>

  <p class="muted" style="margin-top: 16px; max-width: 75ch; line-height: 1.65;">
    This opens your email app with the subject line “Email from WTE Wiki.”
  </p>
</section>
</BaseLayout>
