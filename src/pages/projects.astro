---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
const unavailable: Record<string, string> = { 'https://airventaware.org': 'Certificate needs attention', 'https://crowcrb.org': 'Website currently unavailable' };
---
<BaseLayout title="Projects" description="Explore the WhyTrashEarth project directory, with public sites, developing ideas, and an explanation of the work that remains private.">
  <section aria-labelledby="projects-title">
    <header class="page-heading"><p class="eyebrow">The WhyTrashEarth network</p><h1 id="projects-title">Projects.</h1><p class="intro">A growing index of public sites and initiatives connected to WhyTrashEarth. Some are established resources; others are developing ideas.</p></header>
    <div class="project-grid">{projects.map(([name, url, description]) => <article class="project card"><h2>{name}</h2><p>{description}</p>{unavailable[url] ? <div class="project-status"><span>{unavailable[url]}</span><small>Checked November 25, 2026. We’ll restore the link when it works safely.</small></div> : <a class="text-link" href={url} aria-label={`Visit ${name}`}>Visit site <Icon name="external" /></a>}</article>)}</div>
    <section class="note content" id="public-and-private" aria-labelledby="private-title"><p class="eyebrow">Public &amp; private projects</p><h2 id="private-title">What this directory includes.</h2><p>Not all WhyTrashEarth projects are publicly documented. Many remain private for a variety of reasons: ongoing research, confidentiality, active correspondence, or respect for the individuals and organizations involved.</p><p>This wiki represents our publicly available body of work, not the entirety of our efforts. We share information when it is appropriate to do so.</p><p>A listing describes a project’s focus; it does not imply a completed project, a formal partnership, or a measured outcome. <a href="/contact/">Contact us</a> for a correction or a question about a public project.</p></section>
  </section>
</BaseLayout>
<style>.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.project{padding:1.7rem;display:flex;flex-direction:column;align-items:flex-start}.project h2{font-size:1.3rem;overflow-wrap:anywhere}.project p{font-size:1rem;color:var(--color-muted)}.project .text-link,.project-status{margin-top:auto;font-size:.9rem}.project-status{color:var(--color-accent);border-top:1px solid var(--color-line);padding-top:.65rem}.project-status span{font-weight:700;display:block}.project-status small{display:block;color:var(--color-muted);font-size:.8rem;margin-top:.3rem}.note.content{margin:3rem auto 0}@media(max-width:900px){.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:550px){.project-grid{grid-template-columns:1fr}}</style>
