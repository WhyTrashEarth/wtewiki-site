---
import BaseLayout from "../layouts/BaseLayout.astro";
const projects = [["WhyTrashEarth.org","https://whytrashearth.org","The primary site for WhyTrashEarth and its overall mission."],["AirVentAware.org","https://airventaware.org","Air-quality awareness and ventilation cleanliness."],["AiriVenturi.com","https://airiventuri.com","Home of Airi Venturi, International Air Quality Consultant."],["UXO.INFO","https://uxo.info","Documentation and awareness of unexploded ordnance and environmental impact."],["Menhaden.eco","https://menhaden.eco","Research and awareness surrounding menhaden fishing and ecosystem impact."],["Mekong.Earth","https://mekong.earth","Environmental focus on the Mekong region and its ecosystems."],["Whaling.Watch","https://whaling.watch","Tracking and awareness related to global whaling activity."],["PlasticFree.Flights","https://plasticfree.flights","Exploring less plastic use in aviation."],["EndFast.fashion","https://endfast.fashion","Addressing waste and impact from fast fashion systems."],["EcoWasteWorldwide.org","https://ecowasteworldwide.org","A global perspective on waste systems and environmental impact."],["GlobalAirRegistry.org","https://globalairregistry.org","A concept for tracking and standardizing air-quality data globally."],["SanDiegoSewage.org","https://sandiegosewage.org","Sewage infrastructure and coastal environmental concerns."],["WineWaste.org","https://winewaste.org","Waste and sustainability in wine production."],["ReLive.org","https://relivenv.org","Regional environmental initiatives focused on Nevada."],["WhyTrashTahoe.org","https://whytrashtahoe.org","Environmental efforts focused on Lake Tahoe and surrounding areas."],["CrowCRB.org","https://crowcrb.org","Community-focused environmental documentation and initiatives."],["Arson.News","https://arson.news","Monitoring and documenting fire-related environmental events."],["MakeTheGoal.org","https://makethegoal.org","Measurable environmental progress for FIFA World Cup 2026."],["NV.horse","https://nv.horse","A neutral informational resource related to horse topics in Nevada."]];
---
<BaseLayout title="Projects" description="A directory of projects in the WhyTrashEarth network."><section class="content" aria-labelledby="projects-title"><p class="eyebrow">Directory</p><h1 id="projects-title">Projects</h1><p class="intro">A growing index of public sites and initiatives connected to the WhyTrashEarth network.</p><div class="grid">{projects.map(([name, url, description]) => (<a class="project card p-24" href={url} target="_blank" rel="noopener noreferrer"><h2>{name}</h2><p>{description}</p><span aria-hidden="true">Visit site →</span></a>))}</div></section></BaseLayout>
<style>.intro { font-size: 1.15rem; margin-bottom: 2rem; }.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(245px, 1fr)); gap: 1rem; }.project { display: flex; flex-direction: column; min-height: 13rem; text-decoration: none; transition: transform .16s ease, border-color .16s ease; }.project:hover { border-color: var(--color-accent); transform: translateY(-3px); }.project h2 { font-size: 1.25rem; }.project p { color: var(--color-muted); margin: 0; }.project span { color: var(--color-accent); font-weight: 700; margin-top: auto; padding-top: 1rem; }</style>
