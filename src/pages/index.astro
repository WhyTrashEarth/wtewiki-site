---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const entries = [
  ['01', 'projects', 'Projects', '/projects/', 'Explore the ideas, initiatives, and public sites connected to WTE.'],
  ['02', 'trash', 'Cleanup archive', '/cleanups/', 'Photo galleries and video records, organized from 2016 to today.'],
  ['03', 'notes', 'Updates', '/blog/', 'A place for findings, project notes, and progress as they are published.'],
  ['04', 'info', 'About WTE', '/about/', 'Our purpose, principles, and approach to making things better.'],
  ['05', 'social', 'Official socials', '/socials/', 'Find our accounts and stay connected to WhyTrashEarth.'],
  ['06', 'mail', 'Get in touch', '/contact/', 'Have a question, an idea, or something we should know about?'],
];
---
<BaseLayout title="A public record of work for Earth" description="Explore WhyTrashEarth’s public projects, cleanup archives, ideas, and updates. Independent environmental work since 2016.">
  <section class="home-hero" aria-labelledby="home-title">
    <p class="eyebrow">Independent environmental work · Since 2016</p>
    <h1 id="home-title">One Earth.<br /><span>A growing record.</span></h1>
    <p class="lede">All projects currently active with WhyTrashEarth.</p>
    <div class="actions"><a class="button" href="/start-here/">Start here <Icon name="arrow" /></a><a class="button button--quiet" href="/projects/">Explore the projects <Icon name="projects" /></a></div>
  </section>
  <section aria-labelledby="explore-title" class="home-directory">
    <div class="section-heading"><h2 id="explore-title">Find your way in.</h2><p class="eyebrow">The WTE index</p></div>
    <div class="index-grid">{entries.map(([number, icon, title, href, copy]) => <a class="index-entry" href={href}><div class="entry-top"><Icon name={icon} /><span>{number}</span></div><h3>{title} <Icon name="arrow" /></h3><p>{copy}</p></a>)}</div>
  </section>
  <section class="public-note" aria-labelledby="public-title"><div><p class="eyebrow">Project visibility</p><h2 id="public-title">Public and private work.</h2></div><div><p>Not all WhyTrashEarth projects are public. Many remain private for a variety of reasons, including ongoing work, confidentiality, and respect for the people involved.</p><p>This wiki shares our public work. It does not represent everything we do.</p><a class="text-link" href="/projects/#public-and-private">About public and private projects <Icon name="arrow" /></a></div></section>
</BaseLayout>
<style>
.home-hero{text-align:center;padding:1.2rem 0 4.5rem}.home-hero h1{font-size:clamp(3.1rem,8.5vw,6.5rem);line-height:1.02;letter-spacing:-.055em;margin-bottom:1.7rem}.home-hero h1 span{color:var(--color-accent)}.home-hero .lede{max-width:39rem;margin-inline:auto}.home-hero .actions{justify-content:center}.index-grid{border-radius:var(--radius);overflow:hidden;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fff}.index-entry{padding:1.7rem;border-bottom:1px solid var(--color-line);text-decoration:none;border-right:1px solid var(--color-line)}.index-entry:nth-child(3n){border-right:0}.entry-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.7rem;color:var(--color-accent)}.entry-top span{font-size:.75rem;color:#75756d}.index-entry h3{display:flex;justify-content:space-between;align-items:center;gap:.5rem}.index-entry h3 .icon{width:1rem;height:1rem}.index-entry p{color:var(--color-muted);font-size:.95rem;margin:0}.index-entry:hover{background:#f0f0e9}.index-entry:hover h3{text-decoration:underline}.public-note{display:grid;grid-template-columns:1fr 1.4fr;gap:4rem;padding:3.5rem 0 0}.public-note p{max-width:40rem}.public-note .text-link{font-size:.95rem}
@media(max-width:760px){.index-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.index-entry:nth-child(3n){border-right:1px solid var(--color-line)}.index-entry:nth-child(2n){border-right:0}.public-note{grid-template-columns:1fr;gap:1rem}.home-hero{padding-top:.4rem;padding-bottom:3rem}}
@media(max-width:480px){.index-grid{grid-template-columns:1fr}.index-entry,.index-entry:nth-child(3n){border-right:0;padding:1.5rem}.entry-top{margin-bottom:1rem}.home-hero .eyebrow{font-size:.7rem}.home-hero h1{font-size:clamp(2.6rem,12vw,3.8rem)}}
</style>
