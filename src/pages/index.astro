---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    name: '🌎 WhyTrashEarth.org ',
    url: 'https://whytrashearth.org',
    desc: 'Primary site for WhyTrashEarth and its overall mission.'
  },
  {
    name: '🌬️ AirVentAware.org',
    url: 'https://airventaware.org',
    desc: 'Focused on air quality awareness and ventilation system cleanliness.'
  },
  {
    name: '🌬️ AiriVenturi.com',
    url: 'https://airiventuri.com',
    desc: 'Home of Airi Venturi, International Air Quality Consultant.'
  },
  {
    name: '⚠️ UXO.INFO',
    url: 'https://uxo.info',
    desc: 'Documentation and awareness of unexploded ordnance and environmental impact.'
  },
  {
    name: '🐟 Menhaden.eco',
    url: 'https://menhaden.eco',
    desc: 'Research and awareness surrounding menhaden fishing and ecosystem impact.'
  },
  {
    name: '🏞️ Mekong.Earth',
    url: 'https://mekong.earth',
    desc: 'Environmental focus on the Mekong region and its ecosystems.'
  },
  {
    name: '🐳 Whaling.Watch',
    url: 'https://whaling.watch',
    desc: 'Tracking and awareness related to global whaling activity.'
  },
  {
    name: '✈️ PlasticFree.Flights',
    url: 'https://plasticfree.flights',
    desc: 'Exploring reduction of plastic use in aviation environments.'
  },
  {
    name: '👠 EndFast.fashion',
    url: 'https://endfast.fashion',
    desc: 'Addressing waste and impact from fast fashion systems.'
  },
  {
    name: '🛢️ EcoWasteWorldwide.org',
    url: 'https://ecowasteworldwide.org',
    desc: 'Global perspective on waste systems and environmental impact.'
  },
  {
    name: '🌐 GlobalAirRegistry.org',
    url: 'https://globalairregistry.org',
    desc: 'Concept for tracking and standardizing air quality data globally.'
  },
  {
    name: '🏖️ SanDiegoSewage.org',
    url: 'https://sandiegosewage.org',
    desc: 'Focused on sewage infrastructure and coastal environmental concerns.'
  },
  {
    name: '🍷 WineWaste.org',
    url: 'https://winewaste.org',
    desc: 'Exploring waste and sustainability in wine production.'
  },
  {
    name: '🔋 ReLive.org',
    url: 'https://relivenv.org',
    desc: 'Regional environmental initiatives focused on Nevada.'
  },
  {
    name: '⛰️ WhyTrashTahoe.org',
    url: 'https://whytrashtahoe.org',
    desc: 'Environmental efforts focused on Lake Tahoe and surrounding areas.'
  },
  {
    name: '🐦‍⬛ CrowCRB.org',
    url: 'https://crowcrb.org',
    desc: 'Community-focused environmental documentation and initiatives.'
  },
  {
    name: '🔥 Arson.News',
    url: 'https://arson.news',
    desc: 'Monitoring and documenting fire-related environmental events.'
  },
  {
    name: '⚽ MakeTheGoal.org',
    url: 'https://makethegoal.org',
    desc: 'Initiative focused on measurable environmental progress and outcomes for FIFA World Cup 2026.'
  },
  {
    name: '🐴 NV.horse',
    url: 'https://nv.horse',
    desc: 'Neutral informational resource related to horse-related topics specifically in Nevada.'
  }
];
---

<BaseLayout title="WTEWiki">
  <main class="container">
    <h1>WTE Wiki</h1>
    <p class="intro">
      The official record and collection of WhyTrashEarth's network of projects.
    </p>

    <section class="projects">
      <h2>Project Index</h2>

      <div class="grid">
        {projects.map((project) => (
          <a href={project.url} class="card" target="_blank" rel="noopener noreferrer">
            <h3>{project.name}</h3>
            <p>{project.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    max-width: 700px;
    margin-bottom: 2rem;
    color: #ffffff;
    line-height: 1.6;
  }

  .projects h2 {
    margin-bottom: 1rem;
  }

  .grid {
  display: grid;
  gap: 2rem;
  grid-template-columns: 1fr;
  max-width: 800px;
  margin: 0 auto;
}
  .card {
    display: block;
    text-decoration: none;
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 1rem;
    transition: 0.15s ease;
  }

  .card:hover {
    border-color: #b81212;
    transform: translateY(-2px);
  }

  .card h3 {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    letter-spacing: 0.09em;
    color: #000000;
  }

  .card p {
    margin: 0;
    font-size: 0.95rem;
    color: #2f2f2f;
    line-height: 1.5;
  }
</style>