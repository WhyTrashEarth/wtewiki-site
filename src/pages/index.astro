---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="A public record of environmental work" description="WTE Wiki is the public record and project directory for the WhyTrashEarth network.">
  <section class="hero content" aria-labelledby="home-title">
    <p class="eyebrow">WhyTrashEarth network</p>
    <h1 id="home-title">A clearer record of work for Earth.</h1>
    <p class="lede">WTE Wiki collects the projects, ideas, and updates behind WhyTrashEarth in one calm, public place.</p>
    <div class="actions"><a class="button" href="/start-here">Start here</a><a class="button button--quiet" href="/projects">Browse projects</a></div>
  </section>
  <section class="content" aria-labelledby="explore-title"><div class="card p-24"><p class="eyebrow">Explore</p><h2 id="explore-title">Find your way in</h2><div class="links"><a href="/start-here"><strong>Start Here</strong><span>An introduction to the archive and its purpose.</span></a><a href="/projects"><strong>Projects</strong><span>A directory of the WhyTrashEarth network.</span></a><a href="/blog"><strong>Updates</strong><span>Notes, findings, and project progress.</span></a></div></div></section>
</BaseLayout>
<style>.hero { padding: clamp(2rem, 8vw, 7rem) 0 4rem; }.lede { font-size: clamp(1.15rem, 2.5vw, 1.5rem); max-width: 38rem; }.actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }.links { display: grid; gap: 1rem; margin-top: 1.5rem; }.links a { display: grid; gap: .15rem; padding-top: 1rem; border-top: 1px solid var(--color-line); text-decoration: none; }.links span { color: var(--color-muted); }</style>
