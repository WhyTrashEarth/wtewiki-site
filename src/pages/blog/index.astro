---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Updates" description="Updates, findings, and project notes from WhyTrashEarth."><section class="content" aria-labelledby="updates-title"><p class="eyebrow">Notes and progress</p><h1 id="updates-title">Updates</h1><p class="intro">New posts, findings, and project logs will appear here.</p>{posts.length ? <div class="posts">{posts.map((post) => (<a class="post card p-24" href={`/blog/${post.id}/`}><p class="eyebrow">{post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</p><h2>{post.data.title}</h2>{post.data.description && <p>{post.data.description}</p>}<span>Read update →</span></a>))}</div> : <div class="card p-24 empty"><h2>Updates are on the way.</h2><p>The archive is growing. Check back for project notes, findings, and progress.</p></div>}</section></BaseLayout>
<style>.intro { font-size: 1.15rem; margin-bottom: 2rem; }.posts { display: grid; gap: 1rem; }.post { display: block; text-decoration: none; }.post p:not(.eyebrow), .empty p { color: var(--color-muted); }.post span { color: var(--color-accent); font-weight: 700; }.empty h2 { font-size: 1.5rem; }</style>
