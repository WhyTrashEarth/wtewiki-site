---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const pages = [['Start here','/start-here/','An introduction to the archive.'], ['Projects','/projects/','Public sites and the wider body of work.'], ['Cleanups','/cleanups/','Photo galleries and video playlists from 2016–2026.'], ['Updates','/blog/','Notes and progress as they are published.'], ['About','/about/','The purpose and principles of WhyTrashEarth.'], ['Official socials','/socials/','Verified public accounts and the Discord username.'], ['Contact','/contact/','Email and direct-message options.'], ['Privacy','/privacy/','How this website handles information.'], ['Sharing assets','/open-graph/','Stable social-preview images for the network.']];
---
<BaseLayout title="Site map" description="Find every public section of WTE Wiki, from projects and cleanup archives to official socials, contact details, and privacy."><section class="content"><header class="page-heading"><p class="eyebrow">Around the archive</p><h1>Site map.</h1><p class="intro">All the public sections, in one place.</p></header><ul class="directory-list">{pages.map(([label,href,description])=><li><a href={href}><span class="link-copy"><strong>{label}</strong><span>{description}</span></span><Icon name="arrow" /></a></li>)}</ul><p style="margin-top:2rem">For crawlers: <a href="/sitemap-index.xml">XML sitemap</a> · <a href="/robots.txt">robots.txt</a></p></section></BaseLayout>
