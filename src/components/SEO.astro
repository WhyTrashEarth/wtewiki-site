---
import { SITE } from "@/config/site";

export type Props = {
  title?: string;
  description?: string;
  canonical?: string; // optional explicit canonical
  ogImage?: string;   // absolute or site-relative (/og/og-default.png)
  noIndex?: boolean;
  updated?: string;
};

const {
  title,
  description = SITE.description,
  canonical,
  ogImage = "/og/wtewiki/default-v1.jpg",
  noIndex = false,
  updated
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? SITE.canonicalBase ?? "";
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const url = new URL(pathname, site || Astro.url.origin).toString();

const finalTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const finalCanonical = canonical ?? url;

const ogUrl = finalCanonical;
const ogImg = ogImage.startsWith("http") ? ogImage : (site ? `${site}${ogImage}` : ogImage);
const ogImageAlt = 'WTE Wiki — WhyTrashEarth';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: finalTitle, description, url: finalCanonical,
  ...(updated ? { dateModified: updated } : {}),
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: site },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{finalTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={finalCanonical} />

<link rel="icon" type="image/png" href="/favicon.png" />

{noIndex ? <meta name="robots" content="noindex,follow" /> : null}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImg} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImg} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<meta name="theme-color" content="#080808" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:site" content="@WhyTrashEarth" />
{!noIndex && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
