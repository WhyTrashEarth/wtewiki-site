---
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['Projects', '/projects/'], ['Cleanups', '/cleanups/'], ['Updates', '/blog/'], ['About', '/about/'], ['Socials', '/socials/']];
---
<header class="site-header">
  <nav class="container header-inner" aria-label="Primary">
    <a href="/" class="brand" aria-label="WTE Wiki home" aria-current={current === '/' ? 'page' : undefined}>
      <img src="/images/whytrashearth-logo-giri.webp" width="460" height="460" alt="" fetchpriority="high" />
      <span>WTE<span class="brand-wiki">.Wiki</span><small>WhyTrashEarth</small></span>
    </a>
    <div class="nav-links">{links.map(([label, href]) => <a href={href} aria-current={current === href.replace(/\/$/, '') || current.startsWith(href) ? 'page' : undefined}>{label}</a>)}</div>
  </nav>
</header>
