---
import Icon from './Icon.astro';
import { dateLabel } from '../data/page-dates.mjs';
interface Props { updated?: string; }
const { updated } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const groups = [
  { title: 'Explore', links: [['Start here', '/start-here/'], ['Projects', '/projects/'], ['Cleanups', '/cleanups/'], ['Updates', '/blog/']] },
  { title: 'Connect', links: [['About WTE', '/about/'], ['Official socials', '/socials/'], ['Contact', '/contact/'], ['WhyTrashEarth.org', 'https://whytrashearth.org/']] },
  { title: 'Resources', links: [['Privacy', '/privacy/'], ['Site map', '/sitemap/'], ['Sharing assets', '/open-graph/']] },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-identity">
        <a class="brand" href="/" aria-label="WTE Wiki home"><img src="/images/whytrashearth-logo-giri.webp" width="460" height="460" loading="lazy" alt="" /><span>WTE<span class="brand-wiki">.Wiki</span><small>WhyTrashEarth</small></span></a>
        <p>The public archive for the<br />WhyTrashEarth network.</p>
        <span class="footer-since">Independent since 2016.</span>
      </div>
      {groups.map(group => <nav aria-label={`${group.title} footer links`}><h2>{group.title}</h2><ul>{group.links.map(([label, href]) => <li><a href={href} aria-current={current === href.replace(/\/$/, '') ? 'page' : undefined}>{label}{href.startsWith('https:') && <Icon name="external" />}</a></li>)}</ul></nav>)}
    </div>
    <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} WhyTrashEarth · WTE Wiki</span>{updated && <span>Page updated <time datetime={updated}>{dateLabel(updated)}</time></span>}</div>
  </div>
</footer>
