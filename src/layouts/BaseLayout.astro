---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import SkipLink from "../components/SkipLink.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { pageDates, normalizePath } from "../data/page-dates.mjs";

export type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
  updated?: string;
};

const { title, description, canonical, ogImage, noIndex, updated = pageDates[normalizePath(Astro.url.pathname) as keyof typeof pageDates] } = Astro.props;
---
<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} noIndex={noIndex} updated={updated} />
  </head>
  <body>
    <SkipLink />
    <Header />

    <main id="main-content" class="container page" tabindex="-1">
      <slot />
    </main>

    <Footer updated={updated} />
  </body>
</html>
